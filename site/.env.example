# Copy to .env.local. NEVER commit real secrets.
# Use the Supabase Connect panel -> Session pooler (IPv4 compatible), not the raw db host.
# The PostgreSQL database is 'postgres'; Payload tables live in the private 'ogastv' schema.
# Obtain the exact pooler hostname from Supabase; never commit the actual connection string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
# Generate a strong random secret, at least 32 bytes of entropy.
PAYLOAD_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Temporary, read-only migration source. No WordPress writes.
WORDPRESS_API_BASE=https://ogastvafrica.ng/wp-json/wp/v2
# Streaming provider integration will be configured separately.
NEXT_PUBLIC_OGASTV_LIVE_YOUTUBE_ID=

# Do not enable on publicly accessible initial installation.
ALLOW_FIRST_ADMIN_SETUP=false
# Switch to payload ONLY after content import and validation.
CMS_CONTENT_SOURCE=wordpress

# Keep reader registration closed until SMTP verification works.
READER_SIGNUP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
