{
  "name": "ogastv-publication",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "payload generate:types && node scripts/clean-next-output.mjs && next build --webpack && node scripts/prepare-standalone-assets.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "cms:types": "payload generate:types",
    "cms:migrate": "payload migrate",
    "cms:migrate:create": "payload migrate:create",
    "audit:wordpress": "node scripts/audit-wordpress.mjs",
    "build:staging": "payload migrate && npm run build",
    "build:production": "npm run build",
    "import:wordpress": "payload run ./scripts/import-wordpress-content.ts",
    "audit:wordpress:strict": "node ./scripts/audit-wordpress-source.mjs",
    "import:staging:once": "payload migrate && WORDPRESS_IMPORT_EXECUTE=YES payload run ./scripts/import-wordpress-content.ts && npm run build",
    "cms:migrate:production": "payload migrate"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "payload": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-s3": "3.93.0",
    "sharp": "^0.35.5",
    "sanitize-html": "^2.17.0",
    "html-entities": "^2.6.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "nodemailer": "^7.0.10",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "lucide-react": "^0.468.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "postcss": "^8.5.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
